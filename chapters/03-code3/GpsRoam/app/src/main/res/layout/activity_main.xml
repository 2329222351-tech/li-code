<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <!-- 状态名：颜色随状态变（空闲灰 / 录制红 / 回放蓝 / 暂停黄） -->
    <TextView
        android:id="@+id/tvPhase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/phase_idle"
        android:textColor="@color/text_primary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- 状态行：数字用等宽，避免跳动时左右抖 -->
    <TextView
        android:id="@+id/tvLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:text="@string/line_idle"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- 权限条：只在缺权限时出现，齐了整条隐藏 -->
    <LinearLayout
        android:id="@+id/barPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@color/banner_warn"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvPermission"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/banner_warn_text"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPermission"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/open_dev_options"
            android:textColor="@color/banner_warn_text"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 轨迹预览：占满中间剩余空间，把控制区顶到拇指够得着的下方 -->
    <com.gpsroam.ui.TrackPreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1" />

    <!-- 倍速：只在「已选轨迹 / 回放中 / 已暂停」出现 -->
    <LinearLayout
        android:id="@+id/groupSpeed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/spd1x"
            style="@style/SpeedButton"
            android:text="@string/spd_1x" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/spd2x"
            style="@style/SpeedButton"
            android:text="@string/spd_2x" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/spd5x"
            style="@style/SpeedButton"
            android:text="@string/spd_5x" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/spd10x"
            style="@style/SpeedButton"
            android:text="@string/spd_10x" />
    </LinearLayout>

    <!-- 主按钮：永远是最大、位置最固定的那一个 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPrimary"
        style="@style/PrimaryButton"
        android:layout_marginTop="14dp"
        android:text="@string/btn_start_record" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSecondary"
        style="@style/SecondaryButton"
        android:layout_marginTop="2dp"
        android:text="@string/btn_pick_track" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLibrary"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/btn_library_empty"
        android:textColor="@color/text_tertiary"
        android:textSize="13sp" />

</LinearLayout>
