{
  "appId": "com.minimax.code21",
  "productName": "学生手册背诵",
  "copyright": "Copyright © 2026",
  "asar": true,
  "compression": "maximum",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": ".output",
      "to": "nitro",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "artifactName": "学生手册背诵-${version}.${ext}",
    "signAndEditExecutable": false
  },
  "portable": {
    "artifactName": "学生手册背诵-${version}.${ext}",
    "requestExecutionLevel": "user"
  }
}
